# Copy to .env.local and fill in. Do not commit real keys.
VITE_GOOGLE_MAPS_API_KEY=
# Stripe (Payment Element on /booking/payment) — publishable key only; secret stays on FastAPI.
VITE_STRIPE_PUBLISHABLE_KEY=
# FastAPI — browser calls this URL directly (CORS must allow your site). Also set on Vercel.
VITE_ADMIN_API_BASE_URL=https://backend.quickoo.co.uk
# Optional: Express-only (e.g. local scripts); client uses VITE_ADMIN_API_BASE_URL.
ADMIN_API_BASE_URL=http://0.0.0.0:8000

# SMTP config for booking confirmation email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BOOKING_ADMIN_EMAIL=inquiry@quickoo.co.uk
